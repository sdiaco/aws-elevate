{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "aws-elevate rules",
  "description": "Same constraints as the service parser, except default <= max, unique rule ids and unique accounts, which draft-04 cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": {"enum": [1]},
    "rules": {"type": "array", "items": {"$ref": "#/definitions/rule"}}
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/definitions/text"}, "name": {"$ref": "#/definitions/text"}}
    },
    "seconds": {"type": "integer", "minimum": 300, "maximum": 43200},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "permissionSet", "accounts", "duration", "approval", "approverGroup", "privileged"],
      "properties": {
        "id": {"$ref": "#/definitions/text"},
        "group": {"$ref": "#/definitions/ref"},
        "permissionSet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arn", "name"],
          "properties": {
            "arn": {"type": "string", "pattern": "^arn:aws[a-z-]*:sso:::permissionSet/ssoins-[0-9a-f]+/ps-[0-9a-f]+$"},
            "name": {"$ref": "#/definitions/text"}
          }
        },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {"type": "string", "pattern": "^[0-9]{12}$"},
              "name": {"$ref": "#/definitions/text"}
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultSeconds", "maxSeconds"],
          "properties": {
            "defaultSeconds": {"$ref": "#/definitions/seconds"},
            "maxSeconds": {"$ref": "#/definitions/seconds"}
          }
        },
        "approval": {"enum": ["auto", "manual"]},
        "approverGroup": {},
        "privileged": {"type": "boolean"}
      },
      "oneOf": [
        {"properties": {"approval": {"enum": ["auto"]}, "approverGroup": {"type": "null"}, "privileged": {"enum": [false]}}},
        {"properties": {"approval": {"enum": ["manual"]}, "approverGroup": {"$ref": "#/definitions/ref"}}}
      ]
    }
  }
}
